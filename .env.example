# Copy to .env for local development. Never commit .env.
#
# The Light Cloud environment doesn't use this file:
#   https://main-collinson-prod-team.light-cloud.io/graphql
# There, DATABASE_URL is set on the app's environment in the Light Cloud console,
# and the platform sets PORT itself.

DATABASE_URL=postgres://weather:weather@localhost:5433/weather

# Optional. The defaults are in src/const: DEFAULT_PORT (server.ts) and
# DEFAULT_FORECAST_TTL_MINUTES (limits.ts). Uncomment only to override them.
# PORT=
# FORECAST_TTL_MINUTES=
