{
  "name": "activity-weather-ranking",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL service that ranks the next 7 days for skiing, surfing and sightseeing, using Open-Meteo weather.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
